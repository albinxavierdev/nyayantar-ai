# RAG-SaaS Prediction-Only .gitignore
# Only files required for prediction/inference

# ===========================================
# ENVIRONMENT & SECRETS
# ===========================================

# Environment variables
.env
.env.local
.env.development
.env.test
.env.production
.env.staging
.env.*.local

# Secrets and credentials
*.key
*.pem
*.p12
*.pfx
secrets/
keys/
certificates/
jwt_secret.txt
refresh_secret.txt
db_credentials.txt
mongodb_uri.txt

# ===========================================
# PYTHON BACKEND
# ===========================================

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Build artifacts
build/
dist/
*.egg-info/

# ===========================================
# NODE.JS FRONTEND
# ===========================================

# Dependencies
node_modules/

# Next.js build output
.next/
out/

# ===========================================
# DATABASES & STORAGE
# ===========================================

# Database files
*.db
*.sqlite
*.sqlite3
mongodb_data/
qdrant_data/

# Vector databases
*.faiss
*.pkl
*.index

# ===========================================
# LEGAL DATA & KNOWLEDGE BASE
# ===========================================

# ALL legal data files (prediction doesn't need training data)
legal_data/
!legal_data/legal_config.json

# ===========================================
# LOGS & TEMPORARY FILES
# ===========================================

# Log files
*.log
logs/
log/

# Temporary files
tmp/
temp/
.tmp/
.temp/
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig

# Cache
.cache/
cache/
*.cache

# ===========================================
# OPERATING SYSTEM
# ===========================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ===========================================
# IDE & EDITORS
# ===========================================

# VSCode
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# JetBrains IDEs
.idea/

# Vim
*.swp
*.swo
*.un~

# ===========================================
# PREDICTION-SPECIFIC EXCLUSIONS
# ===========================================

# Generated documents
generated_docs/
static/generated_docs/

# User data
conversation_data/
user_data/
uploaded_documents/
admin_data/
user_uploads/

# Analytics
analytics/
metrics/
stats/

# Test files
test_results.json
test_output/
tests/
test_*.py
*_test.py

# Development tools
tasks/
setup_scripts/
dev_scripts/
*.dev.*

# Training data
training_data/
train/
train_*.py
*_train.py

# Model training files
models/
checkpoints/
*.model
*.pth
*.pt
*.h5
*.pb

# Data processing scripts
process_*.py
convert_*.py
generate_*.py
embed_*.py

# Jupyter notebooks
*.ipynb
notebooks/

# ===========================================
# KEEP PREDICTION-REQUIRED FILES
# ===========================================

# Keep essential config files
!legal_data/legal_config.json
!config/loaders.yaml
!config/tools.yaml
!docker-compose.yml

# Keep example files
!*.example
!*.sample
!*.template

# Keep core application files
!backend/
!frontend/
!config/

# ===========================================
# EXCLUDE DOCUMENTATION & LEGAL FILES
# ===========================================

# Documentation files
README.md
README*.md
*.md
LICENSE
LICENSE.*
LICENSING.md
CODE_OF_CONDUCT.md
CONTRIBUTING.md
CHANGELOG.md
HISTORY.md
NOTICE
NOTICE.*

# Legal and compliance files
LEGAL.md
TERMS.md
PRIVACY.md
DISCLAIMER.md
COPYRIGHT
COPYRIGHT.*

# Documentation directories
docs/
documentation/
doc/